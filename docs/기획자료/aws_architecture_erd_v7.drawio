_month&lt;/b&gt;&lt;hr&gt;PK* ref_month : DATE&lt;br&gt;PK* hs_code : VARCHAR&lt;br&gt;import_kg : DECIMAL(22,4)&lt;br&gt;export_kg : DECIMAL(22,4)&lt;br&gt;PK* available_at : TIMESTAMP" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=9;fontSize=11;fillColor=#EDF6F0;strokeColor=#84978E;" vertex="1" parent="1"><mxGeometry x="1170" y="35" width="260" height="162" as="geometry" /></mxCell><mxCell id="mart_weekly" value="&lt;b&gt;mart_weekly&lt;/b&gt;&lt;hr&gt;PK* week_start : DATE&lt;br&gt;PK* market_code : VARCHAR&lt;br&gt;PK*,FK series_key : VARCHAR&lt;br&gt;amount_won : DECIMAL(24,2)&lt;br&gt;eligible_amount_won : DECIMAL(24,2)&lt;br&gt;eligible_kg : DECIMAL(24,4)" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=9;fontSize=11;fillColor=#EAF2FD;strokeColor=#84978E;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="260" height="184" as="geometry" /></mxCell><mxCell id="mart_forecast" value="&lt;b&gt;mart_forecast&lt;/b&gt;&lt;hr&gt;PK* as_of : TIMESTAMP&lt;br&gt;PK* target_week : DATE&lt;br&gt;PK* market_code : VARCHAR&lt;br&gt;PK* series_key : VARCHAR&lt;br&gt;PK* model_id : VARCHAR&lt;br&gt;pred_price : DOUBLE&lt;br&gt;lower80 : DOUBLE&lt;br&gt;upper80 : DOUBLE" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=9;fontSize=11;fillColor=#EAF2FD;strokeColor=#84978E;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="260" height="228" as="geometry" /></mxCell><mxCell id="fact_fuel_day" value="&lt;b&gt;fact_fuel_day&lt;/b&gt;&lt;hr&gt;PK* fuel_date : DATE&lt;br&gt;price_won_l : DOUBLE&lt;br&gt;PK* available_at : TIMESTAMP" style="rounded=0;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=9;fontSize=11;fillColor=#FFF4E5;strokeColor=#84978E;" vertex="1" parent="1"><mxGeometry x="1170" y="390" width="260" height="118" as="geometry" /></mxCell><mxCell id="x0" value="market_code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748b;strokeWidth=1.5;